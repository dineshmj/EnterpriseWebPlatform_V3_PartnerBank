{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "//Kestrel": "Window: the customer's browser (never asks for a client certificate). On the home PC, listen on every interface: --Kestrel:Endpoints:Window:Url=https://*:47402",
  "Kestrel": {
    "Endpoints": {
      "Window": {
        "Url": "https://localhost:47402",
        "ClientCertificateMode": "NoCertificate"
      }
    }
  },
  "PartnerBank": {
    "Authority": "https://partner-auth.ewp.home.arpa:47401",
    "ApiInternalBaseUrl": "https://partner-api.ewp.home.arpa:47404",
    "//ResolvePartnerHostsTo": "The authorization server and the API run on the same machine: their host names are resolved to this address, so the home PC needs no hosts-file entries.",
    "ResolvePartnerHostsTo": "127.0.0.1",
    "Tls": {
      "ServerCertificatePath": "%USERPROFILE%\\.ewp-pki\\partner-bank-server.pfx",
      "ServerCertificatePasswordPath": "%USERPROFILE%\\.ewp-pki\\partner-bank-server.pfx.password",
      "TrustRootPath": "%USERPROFILE%\\.ewp-pki\\ewp-trust-root.cer"
    },
    "WindowClientId": "PartnerBank.ProductsWindow",
    "WindowClientSecret": ""
  }
}