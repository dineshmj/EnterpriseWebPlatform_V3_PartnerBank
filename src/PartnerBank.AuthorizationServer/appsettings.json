{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Duende": "Information"
    }
  },
  "AllowedHosts": "*",
  "//Kestrel": "Public: people (never asks for a client certificate). Mtls: EWP's server (a client certificate is required in the TLS handshake). On the home PC, listen on every interface: --Kestrel:Endpoints:Public:Url=https://*:47401 --Kestrel:Endpoints:Mtls:Url=https://*:47411",
  "Kestrel": {
    "Endpoints": {
      "Public": {
        "Url": "https://localhost:47401",
        "ClientCertificateMode": "NoCertificate"
      },
      "Mtls": {
        "Url": "https://localhost:47411",
        "ClientCertificateMode": "RequireCertificate"
      }
    }
  },
  "PartnerBank": {
    "IssuerUri": "https://partner-auth.ewp.home.arpa:47401",
    "MtlsBaseUrl": "https://partner-auth.ewp.home.arpa:47411",
    "Tls": {
      "ServerCertificatePath": "%USERPROFILE%\\.ewp-pki\\partner-bank-server.pfx",
      "ServerCertificatePasswordPath": "%USERPROFILE%\\.ewp-pki\\partner-bank-server.pfx.password",
      "TrustRootPath": "%USERPROFILE%\\.ewp-pki\\ewp-trust-root.cer"
    },
    "EwpClient": {
      "ClientId": "FourWalls.Ewp.PartnerProducts",
      "CertificateSubject": "CN=EWP BSS Partner Products Client, O=Four Walls Inc.",
      "RequestSigningCertificatePath": "%USERPROFILE%\\.ewp-pki\\ewp-request-signing.cer",
      "RedirectUris": []
    },
    "ProductsWindowClient": {
      "ClientId": "PartnerBank.ProductsWindow",
      "Secret": "",
      "RedirectUris": [ "https://partner-products.ewp.home.arpa:47402/signin-oidc" ],
      "PostLogoutRedirectUris": [ "https://partner-products.ewp.home.arpa:47402/signout-callback-oidc" ]
    },
    "DemoCustomers": []
  }
}