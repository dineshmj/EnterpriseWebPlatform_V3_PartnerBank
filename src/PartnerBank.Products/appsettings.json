{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "//Kestrel": "Window: the customer's browser (never asks for a client certificate). Api: EWP's server (a client certificate is required in the TLS handshake). On the home PC, listen on every interface: --Kestrel:Endpoints:Window:Url=https://*:47402 --Kestrel:Endpoints:Api:Url=https://*:47403",
  "Kestrel": {
    "Endpoints": {
      "Window": {
        "Url": "https://localhost:47402",
        "ClientCertificateMode": "NoCertificate"
      },
      "Api": {
        "Url": "https://localhost:47403",
        "ClientCertificateMode": "RequireCertificate"
      }
    }
  },
  "ConnectionStrings": {
    "Products": "Data Source=partner-products.db"
  },
  "PartnerBank": {
    "Authority": "https://partner-auth.ewp.home.arpa:47401",
    "WindowBaseUrl": "https://partner-products.ewp.home.arpa:47402",
    "ApiBaseUrl": "https://partner-api.ewp.home.arpa:47403",
    "//ResolvePartnerHostsTo": "The authorization server runs on the same machine: its host name is resolved to this address, so the home PC needs no hosts-file entries.",
    "ResolvePartnerHostsTo": "127.0.0.1",
    "Tls": {
      "ServerCertificatePath": "%USERPROFILE%\\.ewp-pki\\partner-bank-server.pfx",
      "ServerCertificatePasswordPath": "%USERPROFILE%\\.ewp-pki\\partner-bank-server.pfx.password",
      "TrustRootPath": "%USERPROFILE%\\.ewp-pki\\ewp-trust-root.cer"
    },
    "WindowClientId": "PartnerBank.ProductsWindow",
    "WindowClientSecret": "",
    "EwpClientId": "FourWalls.Ewp.PartnerProducts",
    "HandoffLifetimeSeconds": 120,
    "WindowSessionMinutes": 30,
    "DecisionDelaySeconds": 120
  }
}