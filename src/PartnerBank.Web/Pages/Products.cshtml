@page
@model PartnerBank.Web.Pages.ProductsModel
@{
    ViewData["Title"] = "Our products";
}
<section class="card wide">
    @if (Model.Problem is not null)
    {
        <h1>This window has closed</h1>
        <p class="error" role="alert">@Model.Problem</p>
    }
    else
    {
        <h1>Hello @User.Identity?.Name</h1>
        <p class="lead">Products from Partner Bank, offered through your bank. Choose one to apply.</p>
        <ul class="products">
            @foreach (var product in Model.Products)
            {
                <li class="product">
                    <div>
                        <span class="product-kind">@product.Kind</span>
                        <h2>@product.Name</h2>
                        <p>@product.Summary</p>
                    </div>
                    <form method="post">
                        <input type="hidden" name="handoff" value="@Model.Handoff" />
                        <input type="hidden" name="productCode" value="@product.Code" />
                        <button type="submit">Apply</button>
                    </form>
                </li>
            }
        </ul>
    }
</section>