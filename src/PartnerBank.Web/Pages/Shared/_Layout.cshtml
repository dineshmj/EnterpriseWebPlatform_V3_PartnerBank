<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Partner Bank</title>
    <link rel="stylesheet" href="~/css/partner.css" asp-append-version="true" />
</head>
<body>
    <header class="brand">
        <span class="brand-mark" aria-hidden="true">PB</span>
        <span class="brand-name">Partner Bank</span>
        <a class="brand-link" href="~/My">My Partner Bank</a>
        <span class="brand-note">Proof of concept - not a real bank</span>
    </header>
    <main class="page">
        @RenderBody()
    </main>
</body>
</html>